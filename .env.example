# Copy to .env next to docker-compose.yml. Never commit .env.

# One Discord webhook per route. Create them in Discord: channel → Integrations → Webhooks.
DISCORD_WEBHOOK_CRITICAL=https://discord.com/api/webhooks/ID/TOKEN
DISCORD_WEBHOOK_WARNING=https://discord.com/api/webhooks/ID/TOKEN
DISCORD_WEBHOOK_DAILY=https://discord.com/api/webhooks/ID/TOKEN
DISCORD_WEBHOOK_MEDIA=https://discord.com/api/webhooks/ID/TOKEN
DISCORD_WEBHOOK_BACKUPS=https://discord.com/api/webhooks/ID/TOKEN
DISCORD_WEBHOOK_UPDATES=https://discord.com/api/webhooks/ID/TOKEN

# Shared secret every sender must present (X-Relay-Token header, Authorization: Bearer, or ?token=).
# Generate: openssl rand -hex 24
RELAY_TOKEN=CHANGE_ME_at_least_16_chars
# Optional extra scoped tokens: "token:source1|source2,token2:*"
# RELAY_TOKENS=

# Delivery history (Postgres). Leave unset to run without history.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://discorelay:CHANGE_ME@db:5432/discorelay
RETENTION_DAYS=90

# Dedup: identical payloads from the same source are sent at most once per window.
DEDUP_WINDOW_SEC=300

# Expose /metrics without a token (only on a trusted network).
METRICS_PUBLIC=false
LOG_LEVEL=info
