{
  "port": 3080,
  "discord": {
    "critical": "PASTE_YOUR_WEBHOOK_HERE or set DISCORD_WEBHOOK_CRITICAL",
    "warning": "PASTE_YOUR_WEBHOOK_HERE or set DISCORD_WEBHOOK_WARNING",
    "daily": "PASTE_YOUR_WEBHOOK_HERE or set DISCORD_WEBHOOK_DAILY",
    "media": "PASTE_YOUR_WEBHOOK_HERE or set DISCORD_WEBHOOK_MEDIA",
    "backups": "PASTE_YOUR_WEBHOOK_HERE or set DISCORD_WEBHOOK_BACKUPS",
    "updates": "PASTE_YOUR_WEBHOOK_HERE or set DISCORD_WEBHOOK_UPDATES"
  },
  "auth": {
    "required": true,
    "tokens": {}
  },
  "dedup": {
    "window_sec": 300,
    "max_entries": 5000
  },
  "delivery": {
    "timeout_ms": 10000,
    "max_attempts": 5,
    "backoff_base_ms": 1000,
    "backoff_max_ms": 30000,
    "max_rate_limit_waits": 5,
    "max_rate_limit_wait_ms": 60000
  },
  "store": {
    "retention_days": 90
  },
  "metrics": {
    "public": false
  },
  "geoip": {
    "enabled": true,
    "map": true,
    "zoom": 10,
    "per_minute": 40
  },
  "channels": {},
  "sources": {
    "generic": {
      "route": "auto",
      "icon": ""
    },
    "discord": {
      "route": "daily"
    },
    "notifiarr": {
      "route": "daily"
    },
    "diun": {
      "route": "updates",
      "dedup_window_sec": 86400,
      "forward": [],
      "icon": "https://raw.githubusercontent.com/crazy-max/diun/master/.github/diun.png"
    },
    "graylog": {
      "route": "auto",
      "icon": "https://raw.githubusercontent.com/Graylog2/graylog2-server/master/graylog2-web-interface/public/images/favicon.png"
    },
    "grafana": {
      "route": "auto",
      "color": {
        "critical": "#DC2626",
        "warning": "#F59E0B",
        "resolved": "#22C55E",
        "info": "#3B82F6"
      },
      "icon": "https://raw.githubusercontent.com/grafana/grafana/main/public/img/grafana_icon.svg"
    },
    "radarr": {
      "route": "media",
      "dedup_window_sec": 0,
      "color": "#FFA500",
      "icon": "https://raw.githubusercontent.com/Radarr/Radarr/develop/Logo/256.png"
    },
    "sonarr": {
      "route": "media",
      "dedup_window_sec": 0,
      "color": "#00BFFF",
      "icon": "https://raw.githubusercontent.com/Sonarr/Sonarr/develop/Logo/256.png"
    },
    "lidarr": {
      "route": "media",
      "dedup_window_sec": 0,
      "color": "#00FF00",
      "icon": "https://raw.githubusercontent.com/Lidarr/Lidarr/develop/Logo/256.png"
    },
    "tautulli": {
      "route": "media",
      "dedup_window_sec": 0,
      "color": "#CC7B19",
      "icon": "https://raw.githubusercontent.com/Tautulli/Tautulli/master/data/interfaces/default/images/logo-circle.png"
    },
    "backrest": {
      "route": "auto",
      "dedup_window_sec": 0,
      "color": "#4A90D9",
      "icon": "https://raw.githubusercontent.com/garethgeorge/backrest/main/webui/public/favicon.ico"
    },
    "uptimekuma": {
      "route": "auto",
      "color": "#5CDD8B",
      "icon": "https://raw.githubusercontent.com/louislam/uptime-kuma/master/public/icon.png"
    },
    "homeassistant": {
      "route": "auto",
      "color": {
        "critical": "#DC2626",
        "warning": "#F59E0B",
        "recovery": "#22C55E",
        "info": "#3B82F6"
      },
      "icon": "https://raw.githubusercontent.com/home-assistant/assets/master/logo/logo-pretty.png"
    },
    "unraid": {
      "route": "auto",
      "color": {
        "alert": "#E23636",
        "warning": "#FFAA2C",
        "normal": "#0099FF"
      },
      "icon": "https://craftassets.unraid.net/uploads/logos/un-mark-gradient@2x.png"
    },
    "check4updates": {
      "route": "auto",
      "dedup_window_sec": 0,
      "color": {
        "updates": "#FFAA2C",
        "current": "#2ECC71"
      },
      "icon": ""
    },
    "crowdsec": {
      "route": "warning",
      "color": "#DC2626",
      "icon": "https://raw.githubusercontent.com/crowdsecurity/crowdsec-docs/main/crowdsec-docs/static/img/crowdsec_logo.png"
    },
    "unifi": {
      "route": "auto",
      "color": {
        "critical": "#DC2626",
        "warning": "#F59E0B",
        "info": "#3498DB"
      },
      "icon": "https://raw.githubusercontent.com/homebridge/branding/latest/logos/homebridge-unifi.png"
    }
  }
}
